# uv virtualenv for the plotting scripts (bench/plot_density.py).
# Recreate with: uv venv .venv && uv pip install --python .venv matplotlib numpy
.venv/

# Datasets are never committed (bench/fetch_corpora.sh fetches them), but the
# directory's README must be, since it is the durable description of every
# corpus -- provenance, measured shape, citation, and the exact conversion
# command -- for when a URL rots. Excluding `data/` outright would make that
# impossible: git cannot re-include a file whose parent directory is excluded.
data/*
!data/README.md
*.pack

# Benchmark corpora -- never committed. Fetch with bench/fetch_corpora.sh;
# data/README.md describes each dataset so it stays identifiable if a URL rots.
# cmake-free build output (build/ is already ignored above)
build_portable/

# uv virtualenv
.venv/
