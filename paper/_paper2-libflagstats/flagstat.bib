@article{Murray2017,
abstract = {The extinct passenger pigeon was once the most abundant bird in North America, and possibly the world. Although theory predicts that large populations will be more genetically diverse, passenger pigeon genetic diversity was surprisingly low. To investigate this disconnect, we analyzed 41 mitochondrial and 4 nuclear genomes from passenger pigeons and 2 genomes from band-tailed pigeons, which are passenger pigeons' closest living relatives. Passenger pigeons' large population size appears to have allowed for faster adaptive evolution and removal of harmful mutations, driving a huge loss in their neutral genetic diversity. These results demonstrate the effect that selection can have on a vertebrate genome and contradict results that suggested that population instability contributed to this species's surprisingly rapid extinction.},
author = {Murray, Gemma G.R. and Soares, Andr{\'{e}} E.R. and Novak, Ben J. and Schaefer, Nathan K. and Cahill, James A. and Baker, Allan J. and Demboski, John R. and Doll, Andrew and {Da Fonseca}, Rute R. and Fulton, Tara L. and Gilbert, Thomas P. and Heintzman, Peter D. and Letts, Brandon and McIntosh, George and O'Connell, Brendan L. and Peck, Mark and Pipes, Marie Lorraine and Rice, Edward S. and Santos, Kathryn M. and Sohrweide, A. Gregory and Vohr, Samuel H. and Corbett-Detig, Russell B. and Green, Richard E. and Shapiro, Beth},
doi = {10.1126/science.aao0960},
file = {::},
issn = {10959203},
journal = {Science},
month = {nov},
number = {6365},
pages = {951--954},
publisher = {American Association for the Advancement of Science},
title = {{Natural selection shaped the rise and fall of passenger pigeon genomic diversity}},
volume = {358},
year = {2017}
}
@article{Alves2019,
abstract = {In the 1950s the myxoma virus was released into European rabbit populations in Australia and Europe, decimating populations and resulting in the rapid evolution of resistance. We investigated the genetic basis of resistance by comparing the exomes of rabbits collected before and after the pandemic. We found a strong pattern of parallel evolution, with selection on standing genetic variation favoring the same alleles in Australia, France, and the United Kingdom. Many of these changes occurred in immunity-related genes, supporting a polygenic basis of resistance. We experimentally validated the role of several genes in viral replication and showed that selection acting on an interferon protein has increased the protein's antiviral effect.},
author = {Alves, Joel M. and Carneiro, Miguel and Cheng, Jade Y. and de Matos, Ana Lemos and Rahman, Masmudur M. and Loog, Liisa and Campos, Paula F. and Wales, Nathan and Eriksson, Anders and Manica, Andrea and Strive, Tanja and Graham, Stephen C. and Afonso, Sandra and Bell, Diana J. and Belmont, Laura and Day, Jonathan P. and Fuller, Susan J. and Marchandeau, St{\'{e}}phane and Palmer, William J. and Queney, Guillaume and Surridge, Alison K. and Vieira, Filipe G. and McFadden, Grant and Nielsen, Rasmus and Thomas, M. and Gilbert, P. and Esteves, Pedro J. and Ferrand, Nuno and Jiggins, Francis M.},
